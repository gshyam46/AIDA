# Frontend environment. On Vercel, set these under Project -> Settings -> Environment Variables.

# "preview" publishes only the landing and benchmarks pages; account pages show the early-access form
# and the data API proxy returns 503. Leave empty when a backend is available.
NEXT_PUBLIC_AIDA_MODE=preview

# URL of the AIDA backend used by the /api/v1 proxy (server-side only).
BACKEND_URL=http://127.0.0.1:8000

# Early-access interest capture (/api/interest). Use Supabase, or a webhook, or both left empty (the form then
# reports that details could not be saved). The Supabase key is a server-side secret: never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_INTEREST_TABLE=aida_interest
INTEREST_WEBHOOK_URL=
