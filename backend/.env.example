# Copy to backend/.env and fill in values. Never commit backend/.env.

# Language interpretation provider: "local" (llama.cpp on 127.0.0.1:8081) or "groq".
# With groq, each uncached question and the approved business catalog labels are
# sent to Groq over HTTPS. Database rows, SQL, table/column names and file paths are never sent.
AIDA_MODEL_PROVIDER=groq
GROQ_API_KEY=gsk_replace_with_your_key
AIDA_GROQ_MODEL=openai/gpt-oss-120b
# Maximum seconds to wait when Groq returns a rate-limit response (0-60).
AIDA_GROQ_MAX_WAIT_SECONDS=20
# Concurrent hosted interpretations (1-8). Local llama.cpp always uses 1 slot.
AIDA_MODEL_CONCURRENCY=4
# two_stage resolves names first, then plans; single does both in one call.
AIDA_PIPELINE=two_stage
# When code rejects the model's json, send the exact rejection back once (1) or clarify immediately (0).
AIDA_REPAIR_ATTEMPTS=1
# Prompt-attack screen before planning (Groq only). Leave empty to disable.
AIDA_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m

# Local provider settings (used when AIDA_MODEL_PROVIDER=local).
AIDA_MODEL_ENDPOINT=http://127.0.0.1:8081/v1/chat/completions
AIDA_MODEL_NAME=aida-semantic

# Accounts, sessions and abuse controls. Keep authentication enabled.
AIDA_REQUIRE_AUTH=1
# Set to 1 only when the site is served over HTTPS.
AIDA_COOKIE_SECURE=0
# Allow new account sign-ups (1) or restrict to existing accounts (0).
AIDA_ALLOW_SIGNUP=1
